# Copy this file to .env.local for local development.
# On Netlify: Site configuration -> Environment variables -> add the same keys.

# Public URL of the live website (used for SEO canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://infinitesofttech.com

# Admin panel login (/admin). CHANGE THESE before going live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
# Long random string used to sign the admin session cookie (min 32 characters)
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Optional: Google Search Console verification code (content of the meta tag)
GOOGLE_SITE_VERIFICATION=

# Optional: e-mail alert for every new lead using Resend (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@infinitesofttech.com
LEAD_FROM_EMAIL=Infinite Soft Tech <onboarding@resend.dev>
